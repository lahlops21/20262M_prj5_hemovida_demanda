DATABASE_URL="mysql://USUARIO:SENHA@edumysql.acesso.rj.senac.br:3306/NOME_DO_BANCO"

# Tem que ser EXATAMENTE o mesmo JWT_SECRET do MS4 (Usuarios): o MS4 assina o token,
# este servico so confere a assinatura.
JWT_SECRET=
JWT_EXPIRES_IN=1h
PORT=7504

# Deixe "true" SOMENTE depois que o banco (coluna solicitacao_justificativa_emergencia) virar utf8mb4.
# Libera emoji, aspas curvas e outros simbolos na justificativa do pedido emergencial.
JUSTIFICATIVA_UTF8=false
